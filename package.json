{
  "name": "vz10m",
  "private": true,
  "type": "module",
  "description": "A browser editor and librarian for the Casio VZ-10M, and its emulator engine as a package.",
  "scripts": {
    "dev": "pnpm -F vz10m-editor dev",
    "build": "pnpm -F vz10m-editor build",
    "start": "pnpm -F vz10m-editor start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "relay": "pnpm -F vz10m-editor relay",
    "schema:pull": "pnpm -F vz10m-editor schema:pull",
    "banks": "pnpm -F vz10m-editor banks"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.16.1"
}
