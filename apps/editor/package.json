{
  "name": "vz10m-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The VZ-10M editor app.",
  "scripts": {
    "dev": "pnpm engine && pnpm banks && pnpm relay && next dev",
    "build": "pnpm engine && pnpm banks && pnpm relay && next build",
    "start": "next start",
    "test": "node --expose-gc --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "relay": "node scripts/relay.ts",
    "schema:pull": "node scripts/fetch-api-schema.ts",
    "banks": "esbuild worker/banks-worker.ts --bundle --format=esm --target=es2022 --minify --outfile=public/vz-banks.js && cp node_modules/@sqlite.org/sqlite-wasm/dist/sqlite3.wasm public/sqlite3.wasm",
    "engine": "pnpm -F @dblodorn/casio-vz-engine build:worklet"
  },
  "dependencies": {
    "@dblodorn/casio-vz-engine": "workspace:*",
    "@dblodorn/sound-tokens": "0.1.0",
    "@dblodorn/sound-ui": "0.3.1",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "next": "^15.5.7",
    "obscenity": "0.4.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-relay": "^21.0.1",
    "relay-runtime": "^21.0.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-relay": "^18.2.1",
    "@types/relay-runtime": "^20.1.1",
    "esbuild": "0.25.12",
    "get-graphql-schema": "^2.1.2",
    "postcss": "^8.5.32",
    "relay-compiler": "^21.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3"
  }
}
